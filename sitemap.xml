<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  Neoteric ERA — sitemap.xml
  ----------------------------------------------------------------------------
  This file lists ONLY pages that exist as files in this build. A sitemap that
  advertises URLs which return 404 is worse than a short one: Search Console
  reports the errors and the whole file is discounted as a discovery signal.

  BEFORE LAUNCH:
    1. Replace www.neotericera.com with the production domain — here, in
       robots.txt, and in the canonical/og:url tags in every page head.
    2. Set <lastmod> from real publication dates. Every page claiming the same
       date is read as noise and ignored as a freshness signal.
    3. Regenerate whenever pages are added. Hand maintenance drifts.

  DELIBERATELY EXCLUDED:
    404.html             carries noindex; an error page must never be submitted.
    service-detail.html  a query-string template (?service=...), not a page.
                         robots.txt blocks the parameterised forms so one
                         template is not indexed a dozen times over. When these
                         become real paths (/services/seo/local-seo/), add each
                         here and drop the matching Disallow rule.

  Note on <priority> and <changefreq>: Google has stated it ignores both. They
  are retained because some other crawlers still read them, and they cost
  nothing.
  ============================================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- ===================== Primary ===================== -->
  <url>
    <loc>https://www.neotericera.com/</loc>
    <lastmod>2026-07-26</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.neotericera.com/services.html</loc>
    <lastmod>2026-07-26</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
